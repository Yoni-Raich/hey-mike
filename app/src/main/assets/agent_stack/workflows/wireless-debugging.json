{
  "id": "wireless-debugging",
  "version": 1,
  "package": "com.android.settings",
  "description": "Turn on Wireless debugging from Settings search. Asks before flipping the switch.",
  "steps": [
    {
      "id": "open_settings",
      "action": "open_app",
      "arguments": { "package": "com.android.settings" },
      "verify": { "package": "com.android.settings" }
    },
    {
      "id": "open_search",
      "action": "tap",
      "target": {
        "resourceId": "com.android.settings:id/search_action_bar",
        "text": "Search settings"
      },
      "verify": { "present": { "className": "EditText" } }
    },
    {
      "id": "search",
      "action": "type_text",
      "text": "Wireless debugging",
      "target": { "className": "EditText" },
      "verify": { "present": { "text": "Wireless debugging" } }
    },
    {
      "id": "open_result",
      "action": "tap",
      "target": { "text": "Wireless debugging", "clickable": true },
      "verify": { "present": { "className": "Switch" } }
    },
    {
      "id": "enable",
      "action": "tap",
      "target": { "resourceId": "switch_widget", "className": "Switch" },
      "requiresConfirmation": true,
      "skipIfVerified": true,
      "verify": { "checked": true, "timeoutMs": 8000 }
    }
  ]
}
