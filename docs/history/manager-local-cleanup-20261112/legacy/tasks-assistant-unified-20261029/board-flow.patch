--- /dev/null
+++ b/core/src/main/kotlin/dev/androidagent/core/TaskChanges.kt
@@ -0,0 +1,52 @@
+package dev.androidagent.core
+
+import kotlinx.serialization.Serializable
+
+@Serializable
+data class TaskChange(val before: MikeTask? = null, val after: MikeTask)
+@Serializable
+data class NoteChange(val before: MemoryNote? = null, val after: MemoryNote? = null) {
+    val id: String get() = after?.id ?: before!!.id
+}
+@Serializable
+data class MemberChange(val before: TeamMember? = null, val after: TeamMember? = null) {
+    val id: String get() = after?.id ?: before!!.id
+}
+@Serializable
+data class TaskRun(val id: String, val sessionId: String, val purpose: String, val policyRevision: Long,
+    val inputIds: List<String>, val startedAt: Long, val state: String = "running", val error: String? = null,
+    val eventIds: List<String> = emptyList(), val deepUpkeep: Boolean = false, val nextUpkeepCursor: Int? = null)
+@Serializable
+data class TaskChangeSet(val id: String, val policyRevision: Long,
+    val tasks: List<TaskChange> = emptyList(), val notes: List<NoteChange> = emptyList(),
+    val events: List<TaskEvent> = emptyList(), val baseGeneration: String? = null,
+    val generation: String? = null, val undone: Boolean = false, val members: List<MemberChange> = emptyList())
+data class TaskUndoResult(val restored: Int, val conflicts: Int)
+
+/** An isolated, bounded model view. Its changes do not reach live stores until commit. */
+class StagedTaskData private constructor(
+    val store: InMemoryTaskBoardStore,
+    private val tasksBefore: Map<String, MikeTask>,
+    private val notesBefore: Map<String, MemoryNote>,
+    private val eventIds: Set<String>,
+    private val membersBefore: Map<String, TeamMember>,
+) {
+    suspend fun changes(id: String, policyRevision: Long, baseGeneration: String?, generation: String?): TaskChangeSet {
+        val tasks = store.loadTasks().filter { tasksBefore[it.id] != it }.map { TaskChange(tasksBefore[it.id], it) }
+        val notes = store.loadNotes().filter { notesBefore[it.id] != it }.map { NoteChange(notesBefore[it.id], it) }
+        val members = store.loadMembers().associateBy { it.id }
+        val memberChanges = (membersBefore.keys + members.keys).distinct().filter { membersBefore[it] != members[it] }
+            .map { MemberChange(membersBefore[it], members[it]) }
+        return TaskChangeSet(id, policyRevision, tasks, notes, store.loadEvents().filter { it.id !in eventIds }, baseGeneration, generation, members = memberChanges)
+    }
+    companion object {
+        suspend fun create(source: TaskBoardStore): StagedTaskData {
+            val tasks = source.loadTasks(); val notes = source.loadNotes(); val events = source.loadEvents()
+            val store = InMemoryTaskBoardStore()
+            tasks.forEach { store.saveTask(it) }; store.saveNotes(notes); store.saveSettings(source.loadSettings())
+            source.loadMembers().forEach { store.saveMember(it) }
+            // Original events are supplied separately to the Coach, not duplicated in the staged journal.
+            return StagedTaskData(store, tasks.associateBy { it.id }, notes.associateBy { it.id }, events.map { it.id }.toSet(), source.loadMembers().associateBy { it.id })
+        }
+    }
+}
diff --git a/core/src/main/kotlin/dev/androidagent/core/TaskFollowThrough.kt b/core/src/main/kotlin/dev/androidagent/core/TaskFollowThrough.kt
new file mode 100644
index 00000000..99770917
--- /dev/null
+++ b/core/src/main/kotlin/dev/androidagent/core/TaskFollowThrough.kt
@@ -0,0 +1,72 @@
+package dev.androidagent.core
+
+import kotlinx.serialization.Serializable
+
+/** Follow-up state never grants authority or changes the frozen execution plan. */
+@Serializable
+data class TaskCommitment(
+    val owner: String,
+    val nextCheckAt: Long,
+    val deadlineAt: Long? = null,
+    val completionEvidence: String? = null,
+    val checkedAt: Long? = null,
+)
+
+/** One durable, idempotently delivered message per meaningful task occurrence. */
+@Serializable
+data class TaskBriefing(
+    val id: String,
+    val occurrence: String,
+    val text: String,
+    val createdAt: Long,
+    val sourceRefs: List<TaskSourceRef>,
+    val deliveredAt: Long? = null,
+    val deliveryNote: String? = null,
+)
+
+object TaskFollowThrough {
+    const val DAY = 86_400_000L
+    const val HOUR = 3_600_000L
+    data class ExecutionProfile(val engine: EngineKind, val model: String?, val effort: String?)
+    fun executionProfile(plan: ApprovedTaskPlan?, parent: ChatSession?): ExecutionProfile =
+        if(plan?.engine != null) ExecutionProfile(plan.engine, plan.model, plan.reasoningEffort.takeIf { plan.model != null })
+        else ExecutionProfile(parent?.engine ?: EngineKind.CODEX, parent?.model, parent?.reasoningEffort.takeIf { parent?.model != null })
+
+    fun accepted(task: MikeTask, owner: String, now: Long, until: Long? = null) = TaskCommitment(
+        owner, (until ?: task.deadlineAt?.minus(2 * HOUR)?.coerceAtMost(now + DAY) ?: (now + DAY))
+            .coerceAtLeast(now + 60_000), task.deadlineAt)
+
+    /** The key is stable through delivery/bookkeeping writes and process restarts. */
+    fun occurrence(task: MikeTask, now: Long): String? {
+        if (task.category != TaskCategory.TASK || task.status.closed || task.status == TaskStatus.SNOOZED) return null
+        val commitment = task.commitment
+        if (commitment?.completionEvidence != null) return "resolved:${SignalInbox.idOf(commitment.completionEvidence)}"
+        if (task.status in setOf(TaskStatus.WAITING, TaskStatus.REVIEW, TaskStatus.FAILED, TaskStatus.UNKNOWN))
+            return "${task.status.wire}:${task.execution?.requestId}:${SignalInbox.idOf(task.result)}"
+        if (commitment != null && now >= commitment.nextCheckAt) return "check:${commitment.nextCheckAt}"
+        if (task.status == TaskStatus.PROPOSED) return "proposal:${task.createdAt}:${SignalInbox.idOf(task.deadlineAt, task.why)}"
+        return null
+    }
+
+    fun needsBrief(task: MikeTask, now: Long): Boolean = occurrence(task, now)?.let { it != task.briefing?.occurrence } == true
+
+    /** Only real owner messages enter the feedback path; generated board chat messages cannot loop. */
+    fun captureBoardMessage(role: String, ownerChat: Boolean, executionResult: Boolean): Boolean =
+        (ownerChat && role == "user") || (executionResult && role == "assistant")
+
+    fun feedback(signal: TaskSignal): TaskEvent? = signal.takeIf { it.ownerFeedback && it.source == "chat" && it.sourceVerified }?.let {
+        TaskEvent("feedback:${it.id}", "owner:${it.sessionId}", 0, "feedback", "user", it.at,
+            note = it.text, sourceRefs = listOf(TaskSourcePolicy.of(it)))
+    }
+
+    /** Bounded context selected without mutating usage counts or admitting excluded sources. */
+    fun context(notes: List<MemoryNote>, query: String, allowed: (MemoryNote) -> Boolean): List<MemoryNote> {
+        fun words(s: String) = s.lowercase().split(Regex("[^\\p{L}\\p{N}]+" )).filter { it.length > 1 }.toSet()
+        val wanted = words(query)
+        return notes.filter { it.retiredAt == null && it.supersededBy == null && allowed(it) }
+            .map { it to (words("${it.subject} ${it.text} ${it.cue.orEmpty()}").intersect(wanted).size * 4 +
+                if (it.kind in setOf("preference", "profile") || it.pinned) 2 else 0) }
+            .filter { it.second > 0 }.sortedWith(compareByDescending<Pair<MemoryNote, Int>> { it.second }.thenByDescending { it.first.at })
+            .take(8).map { it.first }
+    }
+}
