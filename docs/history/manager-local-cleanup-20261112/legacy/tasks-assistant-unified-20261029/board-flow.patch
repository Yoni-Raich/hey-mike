+    // ----- Settings ---------------------------------------------------------------
+
+    fun setDiscovery(on: Boolean) {
+        paused = !on
+        scope.launch {
+            board.editSettings { it.copy(discoveryOn = on) }
+            if (!on) { stopBackgroundTurns(); signals.clear() } else { backfillOnce(); tick() }
+        }
