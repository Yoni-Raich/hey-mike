+        val captured = bitmap ?: InstrumentationRegistry.getInstrumentation().uiAutomation.takeScreenshot()
+        requireNotNull(captured)
+        file.outputStream().use { captured.compress(Bitmap.CompressFormat.PNG, 100, it) }
+    }
